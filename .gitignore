```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Testes
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checking and linting
.mypy_cache/
.ruff_cache/
.pyright/

# Build and distribution
build/
dist/
*.egg-info/

# Logs
*.log

# IDEs and editors
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini
